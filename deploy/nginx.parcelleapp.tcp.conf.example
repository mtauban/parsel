server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name parcelle.app www.parcelle.app;

    ssl_certificate /etc/letsencrypt/live/parcelle.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/parcelle.app/privkey.pem;

    access_log /var/log/parcelleapp/nginx_access.log;
    error_log /var/log/parcelleapp/nginx_error.log;

    client_max_body_size 16m;

    location /static/ {
        alias /home/mtauban/parcelle.app/parcelleapp/parsels/static/;
        access_log off;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        include proxy_params;
        proxy_pass http://127.0.0.1:8082;
        proxy_read_timeout 120;
    }
}
